# Merkle allowlist API — environment.
# Copy to .env for local dev; set these as service variables in production.

# Postgres connection string. Railway injects DATABASE_URL for a linked
# Postgres plugin. Defaults to a local dev DB when unset.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/metagame_extensions

# REQUIRED for writes. The deployed merkle validator address for this network.
# POST /trees recomputes the tree root and verifies it against the validator's
# get_tree_root(id); if this is unset every store returns 503
# ("Could not verify tree on-chain"). Must match the network the trees are
# registered on.
#   sepolia: 0x0094393c9516f3a0cb16fd56aaa558d94c2da20a2f5074fd15e6f2624b5daf43
#   mainnet: 0x0570d41b66f0eea3c342d570e456e51194817b8eb563dc580c63c2f3d6e505ec
MERKLE_VALIDATOR_ADDRESS=

# Starknet RPC used for the on-chain root verification. Defaults to Cartridge
# sepolia when unset — set it to the network that matches MERKLE_VALIDATOR_ADDRESS.
STARKNET_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# HTTP port. Railway injects PORT; defaults to 3002 locally.
PORT=3002

# Optional. Comma-separated browser origins allowed to POST/PUT/DELETE. Headless
# server-to-server callers (no Origin header) are always allowed — writes are
# guarded by the on-chain root check, not by Origin. Leave empty to allow any
# browser origin.
# ALLOWED_ORIGINS=https://budokan.gg,https://app.example
